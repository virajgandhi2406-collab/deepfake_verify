# VERITY Environment Configuration (copy to .env for local development; NEVER commit .env)
VERITY_ENVIRONMENT=development
VERITY_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Ethereum / Ganache EVM Settings
VERITY_RPC_URL=http://127.0.0.1:8545
VERITY_NETWORK_NAME=Ganache Local
VERITY_CHAIN_ID=1337
VERITY_CONTRACT_ADDRESS=
# Private key of the submitting Ganache account (set in local .env only; never commit real keys)
VERITY_PRIVATE_KEY=
VERITY_SOLC_VERSION=0.8.20

# Detector & Analysis Configuration
VERITY_DETECTOR_VERSION=heuristic-v2.0.0
VERITY_CONFIG_ID=cfg-2026.11-baseline
VERITY_PHASH_THRESHOLD=10

# Ledger & Storage
VERITY_LEDGER_PATH=
VERITY_DEPLOYMENT_PATH=
VERITY_AUTO_ANCHOR=true
VERITY_CHECKPOINT_INTERVAL=5

# Security & Privacy Controls
VERITY_MAX_IMAGE_MB=25
VERITY_MAX_VIDEO_MB=100
VERITY_MAX_IMAGE_PIXELS=40000000
VERITY_EXPOSE_FILENAMES=false
VERITY_ADMIN_API_KEY=
